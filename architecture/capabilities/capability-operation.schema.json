{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdlc/capability-operation.schema.json",
  "title": "Capability Operation Envelope",
  "type": "object",
  "required": [
    "schema_version",
    "operation_id",
    "capability",
    "capability_resolution",
    "profile_revision",
    "operation",
    "operation_parameters_sha256",
    "requested_by",
    "canonical_owner",
    "target",
    "responsibility",
    "authority",
    "capability_support",
    "fallback_approved",
    "precondition_status",
    "impact",
    "side_effect_class",
    "verification",
    "compensation"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"
    },
    "capability_resolution": {
      "$ref": "#/$defs/capability_resolution"
    },
    "profile_revision": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "operation_parameters_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "canonical_owner": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "required": [
        "provider",
        "project_id",
        "resource_ids",
        "canonical"
      ],
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "canonical": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "responsibility": {
      "type": "object",
      "required": [
        "within_owner_scope",
        "decision_classes"
      ],
      "properties": {
        "within_owner_scope": {
          "type": "boolean"
        },
        "decision_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "enum": [
        "NOT_REQUIRED",
        "REQUIRED",
        "GRANTED",
        "DENIED",
        "UNKNOWN"
      ]
    },
    "capability_support": {
      "enum": [
        "READY",
        "PARTIAL",
        "UNSUPPORTED"
      ]
    },
    "fallback_approved": {
      "type": "boolean"
    },
    "precondition_status": {
      "enum": [
        "MATCHED",
        "MISSING",
        "STALE",
        "UNKNOWN"
      ]
    },
    "impact": {
      "type": "object",
      "required": [
        "resource_count",
        "cross_system",
        "public_visibility",
        "downstream_invalidation",
        "destructive",
        "reversible",
        "ambiguous_identity"
      ],
      "properties": {
        "resource_count": {
          "type": "integer",
          "minimum": 1
        },
        "cross_system": {
          "type": "boolean"
        },
        "public_visibility": {
          "type": "boolean"
        },
        "downstream_invalidation": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        },
        "reversible": {
          "type": "boolean"
        },
        "ambiguous_identity": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "side_effect_class": {
      "enum": [
        "READ",
        "LOCAL_WRITE",
        "EXTERNAL_WRITE",
        "SOURCE_CONTROL",
        "DEPLOYMENT",
        "DESTRUCTIVE",
        "EXTERNAL_COMMUNICATION"
      ]
    },
    "verification": {
      "type": "object",
      "required": [
        "read_after_write_supported",
        "postconditions"
      ],
      "properties": {
        "read_after_write_supported": {
          "type": "boolean"
        },
        "postconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "compensation": {
      "type": "object",
      "required": [
        "supported",
        "strategy"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "strategy": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "capability_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_ref",
        "record_sha256"
      ],
      "properties": {
        "record_ref": {
          "type": "string",
          "minLength": 1
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
