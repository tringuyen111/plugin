{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc-intelligence.local/schemas/workflow-control-result.schema.json",
  "title": "SDLC Intelligence Workflow Control Result",
  "description": "Machine-facing workflow completion semantics. This schema does not prescribe user-facing presentation or domain artifact format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "owner",
    "evidence",
    "blockers",
    "next"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "state": {
      "enum": [
        "READY",
        "PARTIAL",
        "BLOCKED",
        "FAILED"
      ]
    },
    "owner": {
      "$ref": "#/$defs/workflowOwner"
    },
    "subject": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceAxis"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "next": {
      "description": "Optional next-owner routing metadata. Naming a next workflow does not transfer authority and does not require a handoff artifact.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/nextWorkflow"
        }
      ]
    }
  },
  "$defs": {
    "workflowOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "workflow"
      ],
      "properties": {
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "pattern": "^/[a-z0-9-]+$"
        }
      }
    },
    "evidenceAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "profile",
        "status",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "profile": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "status": {
          "enum": [
            "PASS",
            "DIRECTIONAL_PASS",
            "FAIL",
            "NOT_RUN",
            "INCONCLUSIVE",
            "NOT_REQUIRED"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "summary"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "owner_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "unblock_action": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "nextWorkflow": {
      "description": "Canonical next workflow candidate plus condition; routing metadata only, not proof of invocation, authority transfer, or persisted handoff.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_skill",
        "workflow",
        "condition"
      ],
      "properties": {
        "owner_skill": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "pattern": "^/[a-z0-9-]+$"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
