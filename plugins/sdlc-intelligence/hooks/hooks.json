{
  "description": "Load small stateless SDLC Intelligence resident guidance at SessionStart.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 5,
            "additionalContextLimit": 2500,
            "statusMessage": "Loading SDLC resident guidance"
          }
        ]
      }
    ]
  }
}
