{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdlc/skill-manager-artifact-proposal.schema.json",
  "title": "Skill-System Artifact Proposal",
  "type": "object",
  "required": [
    "proposal_id",
    "artifact_type",
    "name",
    "capability_gap",
    "existing_artifacts_considered",
    "ownership",
    "context",
    "depth",
    "capability_contract",
    "artifact_contract",
    "evaluation",
    "lifecycle"
  ],
  "properties": {
    "proposal_id": {
      "type": "string"
    },
    "artifact_type": {
      "enum": [
        "skill",
        "shared_reference",
        "adapter",
        "script",
        "router_route",
        "project_artifact"
      ]
    },
    "name": {
      "type": "string"
    },
    "capability_gap": {
      "type": "object",
      "required": [
        "scenario",
        "current_failure",
        "why_existing_is_insufficient",
        "expected_improvement"
      ],
      "properties": {
        "scenario": {
          "type": "string"
        },
        "current_failure": {
          "type": "string"
        },
        "why_existing_is_insufficient": {
          "type": "string"
        },
        "expected_improvement": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "existing_artifacts_considered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duplicate_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_specific": {
      "type": "boolean"
    },
    "ownership": {
      "type": "object",
      "required": [
        "owns",
        "does_not_own",
        "upstream",
        "downstream",
        "approvals"
      ],
      "properties": {
        "owns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "does_not_own": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "upstream": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "downstream": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": [
        "required",
        "source_authority",
        "missing_behavior",
        "conflict_behavior"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_authority": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_behavior": {
          "type": "string"
        },
        "conflict_behavior": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "depth": {
      "type": "object",
      "required": [
        "mental_model",
        "decision_variables",
        "tradeoffs",
        "failure_correction",
        "quality_ladder"
      ],
      "properties": {
        "mental_model": {
          "type": "string"
        },
        "decision_variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_correction": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality_ladder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "capability_contract": {
      "type": "object",
      "required": [
        "required",
        "optional",
        "side_effects",
        "fallback"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "artifact_contract": {
      "type": "object",
      "required": [
        "inputs",
        "outputs",
        "evidence",
        "next_owner"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_owner": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": [
        "object",
        "null"
      ]
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluation": {
      "type": "object",
      "required": [
        "case_count",
        "comparison_required",
        "runtime_status",
        "critical_invariants"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "comparison_required": {
          "type": "boolean"
        },
        "runtime_status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "INCONCLUSIVE",
            "NOT_REQUIRED"
          ]
        },
        "critical_invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "requested_state",
        "version",
        "migration_notes"
      ],
      "properties": {
        "requested_state": {
          "enum": [
            "DRAFT",
            "REVIEWED",
            "EVALUATED",
            "PROMOTED",
            "MONITORED",
            "REVISED",
            "DEPRECATED"
          ]
        },
        "version": {
          "type": "string"
        },
        "migration_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
