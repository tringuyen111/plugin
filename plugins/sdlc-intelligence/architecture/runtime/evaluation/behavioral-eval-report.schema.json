{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behavioral-eval-report.schema.json",
  "title": "SDLC Intelligence Behavioral Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "suite_id",
    "artifact",
    "execution_environment",
    "evidence_profile",
    "independent_claim_supported",
    "runtime",
    "executions",
    "reviews",
    "comparison",
    "evaluation_status",
    "promotion_gate",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution_environment": {
      "enum": [
        "RUNTIME_ADVISORY",
        "SANDBOX_EXECUTABLE",
        "CANONICAL_SOURCE_QUALIFICATION"
      ]
    },
    "evidence_profile": {
      "enum": [
        null,
        "SANDBOX_OBSERVED",
        "SANDBOX_PROCEDURAL_COMPARISON",
        "RISK_SPECIFIC_ASSURANCE",
        "ATTESTED_INDEPENDENT"
      ]
    },
    "independent_claim_supported": {
      "type": "boolean"
    },
    "runtime": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter_id",
            "host",
            "model"
          ],
          "properties": {
            "adapter_id": {
              "type": "string",
              "minLength": 1
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string"
            }
          }
        }
      ]
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "variant",
          "status"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "enum": [
              "CANDIDATE",
              "BASELINE"
            ]
          },
          "status": {
            "enum": [
              "EXECUTED",
              "ERROR",
              "NOT_RUN"
            ]
          },
          "raw_output_path": {
            "type": "string",
            "minLength": 1
          },
          "raw_output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "variant",
          "overall_status",
          "assertions"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "enum": [
              "CANDIDATE",
              "BASELINE"
            ]
          },
          "overall_status": {
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE",
              "NOT_RUN"
            ]
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "invariant_id",
                "status"
              ],
              "properties": {
                "invariant_id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "INCONCLUSIVE",
                    "NOT_RUN"
                  ]
                },
                "rationale": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "material_regression",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "DIRECTIONAL_PASS",
            "FAIL",
            "INCONCLUSIVE",
            "NOT_RUN",
            "NOT_APPLICABLE"
          ]
        },
        "material_regression": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "evaluation_status": {
      "enum": [
        "PASS",
        "DIRECTIONAL_PASS",
        "FAIL",
        "INCONCLUSIVE",
        "NOT_RUN"
      ]
    },
    "promotion_gate": {
      "enum": [
        "ELIGIBLE",
        "BLOCKED"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_environment": {
            "const": "RUNTIME_ADVISORY"
          }
        },
        "required": [
          "execution_environment"
        ]
      },
      "then": {
        "properties": {
          "evidence_profile": {
            "const": null
          },
          "independent_claim_supported": {
            "const": false
          },
          "runtime": {
            "const": null
          },
          "executions": {
            "items": {
              "properties": {
                "status": {
                  "const": "NOT_RUN"
                }
              }
            }
          },
          "reviews": {
            "items": {
              "properties": {
                "overall_status": {
                  "const": "NOT_RUN"
                },
                "assertions": {
                  "items": {
                    "properties": {
                      "status": {
                        "const": "NOT_RUN"
                      }
                    }
                  }
                }
              }
            }
          },
          "comparison": {
            "properties": {
              "status": {
                "enum": [
                  "NOT_RUN",
                  "NOT_APPLICABLE"
                ]
              }
            }
          },
          "evaluation_status": {
            "const": "NOT_RUN"
          },
          "promotion_gate": {
            "const": "BLOCKED"
          }
        }
      },
      "else": {
        "properties": {
          "evidence_profile": {
            "enum": [
              "SANDBOX_OBSERVED",
              "SANDBOX_PROCEDURAL_COMPARISON",
              "RISK_SPECIFIC_ASSURANCE",
              "ATTESTED_INDEPENDENT"
            ]
          },
          "runtime": {
            "type": "object"
          }
        }
      }
    }
  ]
}
